# 复制为 server/.env 后按需修改（.env 不进仓库）。本地开发什么都不填也能跑。

# 端口与对外地址（邮件里的链接用它）
PORT=8787
PUBLIC_URL=http://localhost:8787

# 数据库文件所在目录（默认 server/data/）
# DATA_DIR=./server/data

# 用于验证码哈希与退订链接签名；生产环境必须设置 32 位以上的随机字符串
# APP_SECRET=

# 管理员（耶鲁登录邮箱，逗号分隔）
ADMIN_EMAILS=

# 允许登录的邮箱域名（子域名自动允许）
# ALLOWED_EMAIL_DOMAINS=yale.edu,aya.yale.edu

# 发信：console = 打印到终端（本地开发）；resend = 真实发送
MAIL_DRIVER=console
# MAIL_FROM=Yalelux <noreply@coffee.acssy.org>
# RESEND_API_KEY=

# 智能推荐（可选）：不填就只用规则推荐
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 隐私说明的版本；改了隐私说明就改这里，所有人下次登录需要重新同意
# CONSENT_VERSION=2026-10

# 放在 Caddy / Nginx 反向代理后面时设为 1（按真实 IP 限流）
# TRUST_PROXY=1

# NODE_ENV=production
