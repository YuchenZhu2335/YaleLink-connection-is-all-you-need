{
  "name": "yalelux",
  "version": "0.1.0",
  "private": true,
  "description": "Yalelux — Where Yale's light connects resources and ideas. 耶鲁在校生与校友的开源社群平台（第一期：Coffee Chat）",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "backup": "node server/backup.js",
    "serve": "python3 -m http.server 8000 --directory web",
    "validate": "node scripts/validate-data.mjs",
    "lint:arch": "node scripts/check-architecture.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:server": "node --test tests/server/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run validate && npm run lint:arch && npm run test:unit && npm run test:server",
    "test": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "license": "MIT"
}
